# ./setup.sh writes .env from this and fills in the first group for you.

# --- Made for you by setup.sh ---
ENCRYPTION_KEY=
RUNNER_TOKEN=
POSTGRES_PASSWORD=
# The one-time link that signs in the first person
SETUP_TOKEN=
SETUP_EMAIL=
# Only with your own web address: turns on HTTPS (see docker-compose.yml)
EMPLIO_DOMAIN=
COMPOSE_PROFILES=
# 1: only the first person can sign up; everyone else is added from the team page
SIGNUPS_CLOSED=1

# --- Needed ---
# Emplio's AI models, on your own account: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# The addresses people use. On a server, put HTTPS in front and use your domain (see README.md).
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Only with a proxy of your own that serves the API somewhere else. Fixed at build time, so use ./setup.sh --build.
NEXT_PUBLIC_API_URL=
# 127.0.0.1: only this machine can open Emplio. Change it only behind your own HTTPS proxy.
BIND_ADDRESS=127.0.0.1

# --- Optional: each feature stays off without its key ---
# Sign-in emails. Without it, codes are written to the log: docker compose logs app | grep "sign-in code"
RESEND_API_KEY=
RESEND_FROM=
# Your own bot, made with @BotFather
# iPhone app notifications (Emplio cloud only: they need the App Store app's Apple key)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=
TELEGRAM_BOT_TOKEN=
# Web search
EXA_API_KEY=
# App sign-ins and actions
COMPOSIO_API_KEY=
# Optional: "Sign in with GitHub" (a GitHub OAuth app; its callback is <API address>/oauth/github/callback). Without them, GitHub connects with a pasted token.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sign-in for apps with no pasted key. An app stays hidden until its client id and secret are set.
# Each app's callback is <API address>/oauth/<app>/callback.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack's "Signing Secret", for events at <API address>/webhooks/app/slack/events
SLACK_SIGNING_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Zoom's "Secret Token", for events at <API address>/webhooks/app/zoom/events
ZOOM_WEBHOOK_SECRET=
# One Google client for Calendar, Docs, Sheets, Meet, Search Console, Analytics and Business Profile: callbacks for
# googlecalendar, googledocs, googlesheets, googlemeet, googlesearchconsole, googleanalytics, googlebusiness
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One Zoho client for Mail, Books, Invoice and CRM: callbacks for zoho_mail, zoho_books, zoho_invoice, zoho
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Where sign-in starts: the data centre the client was made in, like https://accounts.zoho.in. Default: https://accounts.zoho.com
ZOHO_ACCOUNTS_URL=
# Leave empty unless you also use Composio: apps (comma-separated) that stay on Composio for now, and the workspace ids that get our own version of them anyway
KEEP_ON_COMPOSIO=
OWN_APP_TESTERS=
# Voice notes
SARVAM_API_KEY=
# This server's public address, for webhooks from other services
WEBHOOK_URL=

# --- Limits for each computer and browser ---
COMPUTER_MEMORY=2g
COMPUTER_CPUS=2
